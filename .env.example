# Runtime variables for Timeweb App Platform. This file contains no real secrets.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
Firebase__Enabled=false
ConnectionStrings__GovorDbContext=Host=<postgres-host>;Port=5432;Database=default_db;Username=gen_user;Password=<new-password>;SSL Mode=VerifyFull;Root Certificate=/app/certs/postgres-ca.crt
JwtAccessOption__SecretKey=<random-private-key-at-least-32-bytes>
EncryptionOption__Secret=<private-refresh-token-hashing-secret>
